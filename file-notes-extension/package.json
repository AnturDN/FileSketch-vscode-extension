{
  "name": "filesketch",
  "displayName": "FileSketch",
  "description": "Draw and sketch side-by-side visual notes mapped to your active files in VS Code.",
  "version": "1.0.4",
  "publisher": "antur-dev",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "filesketch.toggle",
        "title": "Toggle FileSketch Canvas",
        "category": "FileSketch",
        "icon": "$(pencil)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "filesketch.toggle",
          "group": "navigation",
          "when": "editorTextFocus"
        }
      ]
    }
  },
  "devDependencies": {
    "@types/vscode": "^1.75.0"
  }
}